[Unit]
Description=USB network device (CDC NCM) for the NBT
After=sys-kernel-config.mount
Wants=sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nbt-gadget.sh

[Install]
WantedBy=multi-user.target
